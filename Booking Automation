      "parameters": {
        "jsCode": "const { DateTime } = require('luxon');\n\n// Get form data - adjust field names to match YOUR Google Form\nconst name = $input.item.json['Name'] || $input.item.json['Full Name'];\nconst phone = ($input.item.json['Phone Number'] || $input.item.json['WhatsApp Number'] || '').replace(/\\s/g, '');\nconst service = $input.item.json['Service Type'] || $input.item.json['Service'];\nconst slotText = $input.item.json['Selected Time Slot'] || $input.item.json['Appointment Time'];\nconst timestamp = $input.item.json['Timestamp'] || new Date().toISOString();\n\n// Ensure phone has country code (+27 for South Africa)\nlet formattedPhone = phone;\nif (!phone.startsWith('+')) {\n  formattedPhone = phone.startsWith('0') ? '+27' + phone.substring(1) : '+27' + phone;\n}\n\n// Parse the selected time slot\n// Expected format: \"Thu, 16 Oct 2025 - 10:00\"\nconst match = slotText.match(/(\\d{2} \\w{3} \\d{4}).*?(\\d{2}:\\d{2})/);\n\nif (!match) {\n  throw new Error('Invalid slot format: ' + slotText + '. Expected format like \"Thu, 16 Oct 2025 - 10:00\"');\n}\n\nconst dateStr = match[1]; // \"16 Oct 2025\"\nconst timeStr = match[2]; // \"10:00\"\n\n// Parse into DateTime object (Cape Town timezone)\nconst appointmentDT = DateTime.fromFormat(\n  `${dateStr} ${timeStr}`,\n  'dd MMM yyyy HH:mm',\n  { zone: 'Africa/Johannesburg' }\n);\n\nif (!appointmentDT.isValid) {\n  throw new Error('Could not parse date/time: ' + appointmentDT.invalidReason);\n}\n\n// Generate unique booking ID\nconst bookingID = `${DateTime.fromISO(timestamp).toFormat('yyyyMMdd-HHmmss')}-${name.substring(0, 3).toUpperCase()}`;\n\nreturn [{\n  json: {\n    Name: name,\n    Phone: formattedPhone,\n    Service: service,\n    SelectedSlot: slotText,\n    BookingID: bookingID,\n    Status: 'Pending',\n    appointmentISO: appointmentDT.toISO(),\n    appointmentDate: appointmentDT.toFormat('yyyy-MM-dd'),\n    appointmentTime: appointmentDT.toFormat('HH:mm'),\n    appointmentDisplay: appointmentDT.toFormat('EEEE, dd MMMM yyyy \\\\at HH:mm'),\n    CreatedAt: timestamp,\n    Reminder24hSent: false,\n    Reminder2hSent: false,\n    FollowUpSent: false,\n    CalendarEventID: ''\n  }\n}];"
      },
