    {
      "parameters": {
        "jsCode": "const { DateTime } = require('luxon');\nconst now = DateTime.now().setZone('Africa/Johannesburg');\n\nconst results = {\n  reminder24h: [],\n  reminder2h: [],\n  followUp: []\n};\n\nfor (const item of $input.all()) {\n  const data = item.json;\n  \n  // Skip if not confirmed or missing appointment time\n  if (data.Status !== 'Confirmed' || !data.AppointmentDateTime) continue;\n  \n  const appointmentDT = DateTime.fromISO(data.AppointmentDateTime, { zone: 'Africa/Johannesburg' });\n  \n  if (!appointmentDT.isValid) continue;\n  \n  const hoursUntil = appointmentDT.diff(now, 'hours').hours;\n  const hoursSince = now.diff(appointmentDT, 'hours').hours;\n  \n  // 24h reminder (between 23-25h before)\n  if (hoursUntil >= 23 && hoursUntil <= 25 && data.Reminder24hSent !== 'TRUE' && data.Reminder24hSent !== true) {\n    results.reminder24h.push({\n      ...data,\n      reminderType: '24h',\n      appointmentDisplay: appointmentDT.toFormat('EEEE, dd MMMM yyyy \\\\at HH:mm'),\n      appointmentTime: appointmentDT.toFormat('HH:mm')\n    });\n  }\n  \n  // 2h reminder (between 1.5-2.5h before)\n  if (hoursUntil >= 1.5 && hoursUntil <= 2.5 && data.Reminder2hSent !== 'TRUE' && data.Reminder2hSent !== true) {\n    results.reminder2h.push({\n      ...data,\n      reminderType: '2h',\n      appointmentTime: appointmentDT.toFormat('HH:mm')\n    });\n  }\n  \n  // Follow-up (1-3 hours after appointment)\n  if (hoursSince >= 1 && hoursSince <= 3 && data.FollowUpSent !== 'TRUE' && data.FollowUpSent !== true) {\n    results.followUp.push({\n      ...data,\n      reminderType: 'followup'\n    });\n  }\n}\n\n// Combine all results\nconst allReminders = [...results.reminder24h, ...results.reminder2h, ...results.followUp];\n\nif (allReminders.length === 0) {\n  // Return empty to stop execution\n  return [];\n}\n\nreturn allReminders.map(item => ({ json: item }));"
      },
