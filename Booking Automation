      "parameters": {
        "jsCode": "// Business Configuration\nconst businessHours = {\n  start: 9,              // 9 AM\n  end: 17,               // 5 PM\n  slotDuration: 60,      // minutes per appointment\n  daysAhead: 14,         // how far to book in advance\n  workDays: [1, 2, 3, 4, 5, 6]  // Mon-Sat (0=Sunday, 6=Saturday)\n};\n\n// Timezone: Africa/Johannesburg (GMT+2)\nconst { DateTime } = require('luxon');\nconst timezone = 'Africa/Johannesburg';\n\n// Get busy times from calendar\nconst busyTimes = $input.item.json.calendars?.primary?.busy || [];\n\n// Generate all possible slots\nconst slots = [];\nconst now = DateTime.now().setZone(timezone);\n\nfor (let day = 0; day <= businessHours.daysAhead; day++) {\n  const date = now.plus({ days: day });\n  \n  // Skip if not a working day\n  if (!businessHours.workDays.includes(date.weekday % 7)) continue;\n  \n  // Generate hourly slots for this day\n  for (let hour = businessHours.start; hour < businessHours.end; hour++) {\n    const slotStart = date.set({ hour, minute: 0, second: 0, millisecond: 0 });\n    const slotEnd = slotStart.plus({ minutes: businessHours.slotDuration });\n    \n    // Skip past times (with 2 hour buffer)\n    if (slotStart < now.plus({ hours: 2 })) continue;\n    \n    // Check if slot conflicts with busy times\n    const isAvailable = !busyTimes.some(busy => {\n      const busyStart = DateTime.fromISO(busy.start, { zone: timezone });\n      const busyEnd = DateTime.fromISO(busy.end, { zone: timezone });\n      \n      // Check for overlap\n      return slotStart < busyEnd && slotEnd > busyStart;\n    });\n    \n    if (isAvailable) {\n      slots.push({\n        datetime: slotStart.toISO(),\n        display: slotStart.toFormat('EEE, dd MMM yyyy - HH:mm'),\n        date: slotStart.toFormat('yyyy-MM-dd'),\n        time: slotStart.toFormat('HH:mm'),\n        dayOfWeek: slotStart.toFormat('EEEE')\n      });\n    }\n  }\n}\n\nreturn slots.map(slot => ({ json: slot }));"
      },
